# Copy to .env on the server and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32

SECRET_KEY_BASE=replace_me
FRONTEND_URL=https://chat.nishankrai.com.np
DEFAULT_LOCALE=en
# Only the first admin should sign up; turn this off after creating your account.
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=false

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DATABASE=chatwoot

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_me

ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true

# Outgoing email (invites, password resets, notifications) through Gmail SMTP.
# SMTP_PASSWORD is a Gmail App Password (myaccount.google.com/apppasswords), not the Gmail login password.
MAILER_SENDER_EMAIL=Nishan Kumar Rai <nishanrai341@gmail.com>
SMTP_DOMAIN=gmail.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nishanrai341@gmail.com
SMTP_PASSWORD=replace_me
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
